# Copy to .env and fill in. Never commit .env.

# --- Chain ---
HSK_RPC_URL=https://mainnet.hsk.xyz

# --- Vault and agent ---
# Address printed by "npm run deploy:hsk".
VAULT_ADDRESS=
# Private key of the agent's trading key. It can only swap inside the vault's limits and
# can never withdraw. Use a fresh key that holds a little HSK for gas and nothing else.
# "npm run agent:new-key" creates one here without showing it.
# Leave empty to run in dry-run mode: decisions are made and simulated, nothing is sent.
AGENT_PRIVATE_KEY=
# Set to 1 to force dry-run even with a key.
DRY_RUN=
# USDT the owner deposits with "npm run deposit:hsk".
# AMOUNT_USDT=

# --- Claude judgment and chat (optional) ---
# Without a key the agent runs on rules only and the chat gives a fixed summary.
# "npm run agent:set-api-key -- .env" stores the key here without showing it.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# LLM_EFFORT=medium
# LLM_TIMEOUT_MS=40000
# LLM_MODE=auto        # auto | on | off

# --- Runtime ---
# TICK_SECONDS=30
# PORT=8787
# DATA_DIR=data

# --- Deployment (scripts/deploy.ts) ---
# AGENT_ADDRESS=        # address of the agent key above (required on mainnet)
# VAULT_OWNER=          # defaults to the deployer
# VAULT_ASSETS=WHSK,WETH,WBTC
# POLICY_MAX_TRADE_BPS=1000
# POLICY_MAX_POSITION_BPS=3000
# POLICY_MAX_EXPOSURE_BPS=6000
# POLICY_MAX_SLIPPAGE_BPS=100
# POLICY_STOP_LOSS_BPS=500
# POLICY_MAX_DRAWDOWN_BPS=1000
# POLICY_MAX_TRADES_PER_DAY=12
# POLICY_COOLDOWN_SECONDS=300
# POLICY_TWAP_WINDOW_SECONDS=300
# POLICY_REENTRY_LOCKOUT_SECONDS=3600

# --- Testnet demo ---
# The testnet has its own file, .env.testnet, written by "npm run testnet:keys" and
# "npm run testnet:market". Nothing in this file is used there, and the mainnet owner key
# never is. See "Run it on the HSK Chain testnet" in the README.
