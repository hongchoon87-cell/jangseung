{
  "name": "jangseung-agent-vault",
  "version": "0.1.0",
  "description": "AI trading agent on HSK Chain whose risk limits are enforced by a smart contract vault",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "hardhat build && tsx scripts/export-abi.ts",
    "test": "hardhat test solidity test/AgentVault.t.sol test/TestToken.t.sol",
    "test:fork": "hardhat test solidity test/AgentVaultFork.t.sol test/AgentVaultLimitsFork.t.sol",
    "test:agent": "node --import tsx --test agent/test/*.test.ts",
    "test:all": "hardhat test solidity && npm run test:agent && npm run test:backtest",
    "typecheck": "tsc --noEmit",
    "fork": "hardhat node --network hskFork",
    "fork:setup": "hardhat run scripts/fork-setup.ts --network localhost",
    "fork:move": "hardhat run scripts/fork-move.ts --network localhost",
    "agent:new-key": "tsx scripts/new-agent-key.ts",
    "agent:set-api-key": "tsx scripts/set-api-key.ts",
    "deploy:check": "hardhat run scripts/deploy-check.ts --network hsk",
    "deploy:hsk": "hardhat run scripts/deploy.ts --network hsk",
    "deploy:fork": "hardhat run scripts/deploy.ts --network localhost",
    "deposit:hsk": "hardhat run scripts/deposit.ts --network hsk",
    "verify:hsk": "hardhat run scripts/verify.ts --network hskRead",
    "testnet:verify": "hardhat run scripts/verify.ts --network hskTestnetRead",
    "testnet:keys": "tsx scripts/testnet-keys.ts",
    "testnet:market": "hardhat run scripts/testnet-market.ts --network hskTestnet",
    "testnet:deploy": "hardhat run scripts/testnet-deploy.ts --network hskTestnet",
    "testnet:fund": "hardhat run scripts/testnet-fund.ts --network hskTestnet",
    "testnet:setup": "npm run testnet:market && npm run testnet:deploy && npm run testnet:fund",
    "testnet:keeper": "tsx --env-file=.env.testnet scripts/testnet-keeper.ts",
    "testnet:move": "tsx --env-file=.env.testnet scripts/testnet-move.ts",
    "testnet:fork": "hardhat node --network hskTestnetFork",
    "testnet:fork:market": "hardhat run scripts/testnet-market.ts --network localhost",
    "testnet:fork:deploy": "hardhat run scripts/testnet-deploy.ts --network localhost",
    "testnet:fork:fund": "hardhat run scripts/testnet-fund.ts --network localhost",
    "testnet:fork:setup": "npm run testnet:fork:market && npm run testnet:fork:deploy && npm run testnet:fork:fund",
    "testnet:fork:keeper": "tsx --env-file=.env.testnet-fork scripts/testnet-keeper.ts",
    "testnet:fork:move": "tsx --env-file=.env.testnet-fork scripts/testnet-move.ts",
    "backtest:fetch": "tsx backtest/fetch.ts",
    "backtest:check": "tsx backtest/check.ts",
    "backtest": "tsx backtest/run.ts",
    "test:backtest": "node --import tsx --test backtest/test/*.test.ts",
    "agent": "tsx agent/src/index.ts",
    "agent:fork": "tsx --env-file=.env.fork agent/src/index.ts",
    "agent:testnet": "tsx --env-file=.env.testnet agent/src/index.ts",
    "agent:testnet:fork": "tsx --env-file=.env.testnet-fork agent/src/index.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.10",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^22.20.5",
    "@uniswap/v3-core": "^1.0.2-solc-0.8-simulate",
    "forge-std": "github:foundry-rs/forge-std#v1.17.0",
    "hardhat": "^3.22.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "viem": "^2.58.6",
    "zod": "^3.25.76"
  }
}
